# Copy to .env. Never commit credentials.
ANDROID_UDID=emulator-5554
# Exactly two booted devices for test:parallel:
ANDROID_UDIDS=emulator-5554,emulator-5556
ANDROID_APP_PATH=apps/mda-2.3.0-27.apk
# Local iOS Simulator. Download with: npm run apps:download -- ios-sim
# The IPA above is for Sauce Labs only. Simulator sessions need the .app.
IOS_APP_PATH=apps/My Demo App.app
# Name from `xcrun simctl list devices available`. Appium boots it when IOS_UDID is empty.
IOS_DEVICE_NAME=iPhone 16
IOS_UDID=
# Optional runtime, for example 18.5. Omit to use the newest installed runtime for that device.
# IOS_PLATFORM_VERSION=
# Set ANDROID_HOME and JAVA_HOME in your shell according to docs/setup.md.
# iOS also needs full Xcode, not Command Line Tools. See docs/setup.md.

# Sauce Labs Real Device Cloud. Username and access key: Account > User Settings.
SAUCE_USERNAME=
SAUCE_ACCESS_KEY=
# Account data center: us-west-1, us-east-4, or eu-central-1.
SAUCE_REGION=us-west-1
# Fill from npm run cloud:upload -- android / ios (storage:<file id>):
SAUCE_ANDROID_APP=
SAUCE_IOS_APP=
# Display name or regex, and OS version, from devices the account can allocate.
# A freemium US-West account may not include a Pixel 8 even when the data center has one.
SAUCE_ANDROID_DEVICE=Samsung Galaxy A23 5G
SAUCE_ANDROID_OS=13
SAUCE_IOS_DEVICE=iPhone 13 Pro
SAUCE_IOS_OS=18
# Real-device Appium image. This account rejects the retired alias "stable".
SAUCE_APPIUM_VERSION=appium3-2026-10
BUILD_NAME=triparc-native-2.3.0
